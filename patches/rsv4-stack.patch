+# --- LOCAL PATCH (2026-08-25 + 2026-09-02): honest async state, bounded single-flight queue,
+# parameter validation, honest 404 ---
+# /send used to start a raw thread per request with NO exception capture and NO limit: two
+# clients double-loaded the card (each generation holds its own activations; two at once on a
+# 24 GB card OOM or thrash), and /status inferred state solely from "does the .glb exist yet?"
+# - a crashed worker OR an unknown uid (a worker replaced by the load balancer, a typo) read
+# 'processing' forever, so the only downstream failure detector was generate3d.py's per-seed
+# wall-clock timeout (a replaced worker burned the client's full budget).
+# Now:
+#   * ONE generation thread consumes a FIFO; at most 1 generation in flight and at most
+#     HY3D_QUEUE_MAX (default 4 = the endpoint's REQUEST_COUNT scaling target) queued; beyond
+#     that /send answers 429 + Retry-After + a JSON body, instantly, so the caller can back off
+#     or fan out to another worker instead of piling onto this one.
+#   * /send validates the numeric fields BEFORE accepting the job: octree_resolution 64..512,
+#     num_inference_steps 1..100, guidance_scale 0..30, seed an integer torch can seed with;
+#     anything else is a 400 naming the field. Unknown fields are ignored (never fatal).
+#   * /status knows every uid it has accepted: 'queued' (with position), 'processing', 'error'
+#     (with the exception), 'completed' (file present, as before). An unknown uid is a 404
+#     {"status": "not_found"} - never a guess. generate3d.poll() already stops on 'error' and
+#     on a non-200, so both terminal cases fail a seed in seconds, not minutes.
+#   * A WATCHDOG (2026-09-02 fix round) keeps health honest about the loop itself: a job that
+#     has been 'processing' longer than HY3D_JOB_MAX_S, or a generation thread that died, is
+#     a wedged worker - every outstanding job is failed with a named reason, /queue reports
+#     healthy:false (auth_gate turns that into a 503 on the health path so the load balancer
+#     recycles the worker instead of routing to it) and, unless HY3D_STUCK_EXIT=0, the process
+#     exits 3 so start.sh takes the container down loudly. Before this, a hung CUDA call meant
+#     /ping 200, 'processing' forever, then 429 forever, and nothing ever recycled the worker.
+QUEUE_MAX = max(0, int(os.environ.get("HY3D_QUEUE_MAX", "4")))
+# seconds per outstanding job used for Retry-After (a 4090 does 30 steps at octree 384 in ~10 s;
+# Pascal takes ~180 s - tune per host, it is only advice to the client)
+JOB_ETA_S = max(1, int(os.environ.get("HY3D_JOB_ETA_S", "30")))
+# wall-clock budget for ONE generation before the worker is declared wedged (0 = no budget).
+# Default 900 s = the endpoint's request timeout; the largest job the validator admits (octree
+# 512, 100 steps) is ~1.5 min on a 4090, ~6 min on Pascal-in-container, so 900 s is a hang,
+# not a slow job. Raise it for a slow local rig rather than disabling it.
+JOB_MAX_S = max(0, int(os.environ.get("HY3D_JOB_MAX_S", "900")))
+STUCK_EXIT = os.environ.get("HY3D_STUCK_EXIT", "1") != "0"   # exit 3 once wedged (default on)
+# seconds the wedged process stays up (503 health, /status 'error', /send 503) before exit 3, so
+# a client mid-poll reads the terminal answer and the load balancer sees the 503 first
+STUCK_EXIT_GRACE_S = max(0, int(os.environ.get("HY3D_STUCK_EXIT_GRACE_S", "15")))
+WATCHDOG_S = max(1, int(os.environ.get("HY3D_WATCHDOG_S", "5")))  # watchdog tick
+_JOBS_KEEP = 512                       # terminal records kept for /status before pruning
+_UID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
+
+_JOBS = {}                             # uid -> {"status", "seq", "error", "started_at"}
+_JOBS_LOCK = threading.Lock()
+_JOB_SEQ = 0
+_QUEUE = queue.Queue()                 # (uid, params) FIFO for the single generation thread
+_LOOP_THREAD = None                    # the generation thread, so the watchdog can see it die
+_STUCK = None                          # {"reason", "since"} once the watchdog declared a wedge
+_WATCHDOG_THREAD = None                # the watchdog thread itself, so /queue can see IT die
+_WATCHDOG_LAST = [None]                # monotonic time of the watchdog's last tick
+_WATCHDOG_STOP = threading.Event()     # set -> the watchdog thread returns (tests; never on the endpoint)
+
+_INT_RANGES = {
+    "octree_resolution": (64, 512),
+    "num_inference_steps": (1, 100),
+    # torch.Generator.manual_seed accepts [-2**63, 2**64-1]
+    "seed": (-(1 << 63), (1 << 64) - 1),
+}
+_FLOAT_RANGES = {"guidance_scale": (0.0, 30.0)}
+
+
+def _as_int(v):
+    if isinstance(v, bool):
+        return None
+    if isinstance(v, int):
+        return v
+    if isinstance(v, float) and math.isfinite(v) and v.is_integer():
+        return int(v)
+    if isinstance(v, str) and re.fullmatch(r"\s*[+-]?\d+\s*", v):
+        return int(v)
+    return None
+
+
+def _as_float(v):
+    if isinstance(v, bool):
+        return None
+    if isinstance(v, (int, float)):
+        return float(v) if math.isfinite(v) else None
+    if isinstance(v, str):
+        try:
+            f = float(v)
+        except ValueError:
+            return None
+        return f if math.isfinite(f) else None
+    return None
+
+
+def validate_params(params):
+    """(clean_params, None) or (None, "field: why"). Null-valued keys count as absent."""
+    if not isinstance(params, dict):
+        return None, "body: a JSON object is required"
+    clean = {k: v for k, v in params.items() if v is not None}
+    if "image" not in clean and "mesh" not in clean:
+        return None, "image: required (base64-encoded PNG/JPEG)"
+    if "image" in clean and not (isinstance(clean["image"], str) and clean["image"].strip()):
+        return None, "image: must be a non-empty base64 string"
+    for key, (lo, hi) in _INT_RANGES.items():
+        if key in clean:
+            v = _as_int(clean[key])
+            if v is None:
+                return None, f"{key}: must be an integer"
+            if not lo <= v <= hi:
+                return None, f"{key}: must be within [{lo}, {hi}] (got {v})"
+            clean[key] = v
+    for key, (lo, hi) in _FLOAT_RANGES.items():
+        if key in clean:
+            v = _as_float(clean[key])
+            if v is None:
+                return None, f"{key}: must be a number"
+            if not lo <= v <= hi:
+                return None, f"{key}: must be within [{lo}, {hi}] (got {v})"
+            clean[key] = v
+    if "mc_algo" in clean and clean["mc_algo"] not in ("mc", "dmc"):
+        return None, "mc_algo: must be 'mc' or 'dmc'"
+    if "type" in clean and clean["type"] != "glb":
+        return None, "type: only 'glb' is served by /status"
+    return clean, None
+
+
+def _backlog_locked():
+    """(in_flight, queued); caller holds _JOBS_LOCK."""
+    in_flight = sum(1 for j in _JOBS.values() if j["status"] == "processing")
+    queued = sum(1 for j in _JOBS.values() if j["status"] == "queued")
+    return in_flight, queued
+
+
+def _prune_locked():
+    terminal = sorted((j["seq"], uid) for uid, j in _JOBS.items()
+                      if j["status"] in ("completed", "error"))
+    for _, uid in terminal[:max(0, len(terminal) - _JOBS_KEEP)]:
+        _JOBS.pop(uid, None)
+
+
+def _generation_loop():
+    """The ONLY place worker.generate runs: one job at a time, FIFO, state recorded honestly."""
+    while True:
+        uid, params = _QUEUE.get()
+        try:
+            with _JOBS_LOCK:
+                job = _JOBS.get(uid)
+                if job is None or job["status"] != "queued":
+                    continue           # pruned, or failed by the watchdog while it waited
+                job["status"] = "processing"
+                job["started_at"] = time.monotonic()
+            try:
+                worker.generate(uid, params)
+                _finish(uid, "completed", None)
+            except KeyboardInterrupt:
+                raise
+            except BaseException as e:
+                # BaseException, not Exception: a SystemExit / GeneratorExit raised inside
+                # generate() escaped the old `except Exception`, threading swallowed it, the
+                # loop thread died silently and the job read 'processing' forever behind a
+                # 200 /ping (verifier probe P7, 2026-09-02). Record it and keep serving.
+                logger.error("generate worker crashed for uid %s:\n%s", uid, traceback.format_exc())
+                _finish(uid, "error", f"{type(e).__name__}: {e}")
+        finally:
+            _QUEUE.task_done()
+
+
+def _finish(uid, status, error):
+    """Record uid's terminal state - only while it is still 'processing'. A job the watchdog
+    already failed keeps that verdict (a late real completion still wins on /status because the
+    atomically published file exists and the record is no longer processing/queued), and a
+    pruned record never KeyErrors the loop thread to death."""
+    with _JOBS_LOCK:
+        job = _JOBS.get(uid)
+        if job is not None and job["status"] == "processing":
+            job.update(status=status, error=error)
+
+
+def _health_locked(now):
+    """The worker's honest state for /queue; caller holds _JOBS_LOCK."""
+    in_flight, queued = _backlog_locked()
+    loop_alive = _LOOP_THREAD is not None and _LOOP_THREAD.is_alive()
+    age = None
+    for j in _JOBS.values():
+        if j["status"] == "processing" and j.get("started_at") is not None:
+            age = max(age or 0.0, now - j["started_at"])
+    if _STUCK is not None:
+        reason = _STUCK["reason"]
+    elif not loop_alive:
+        reason = "generation loop thread is dead"
+    else:
+        reason = None
+    # the watchdog's own liveness (2026-09-03): a dead or stalled watchdog means a wedge would go
+    # undetected behind a 200 health - auth_gate treats watchdog_alive:false, or an age over
+    # 3 ticks, as unhealthy (503) so the platform recycles the worker
+    last = _WATCHDOG_LAST[0]
+    wd_age = None if last is None else max(0.0, now - last)
+    wd_alive = (_WATCHDOG_THREAD is not None and _WATCHDOG_THREAD.is_alive()
+                and wd_age is not None and wd_age <= 3 * WATCHDOG_S)
+    return {"in_flight": in_flight, "queued": queued, "queue_max": QUEUE_MAX,
+            "loop_alive": loop_alive, "in_flight_age_s": None if age is None else round(age, 1),
+            "job_max_s": JOB_MAX_S, "stuck": _STUCK is not None,
+            "watchdog_alive": wd_alive, "watchdog_age_s": None if wd_age is None else round(wd_age, 1),
+            "watchdog_tick_s": WATCHDOG_S,
+            "healthy": reason is None, "reason": reason}
+
+
+def _watchdog():
+    """Declares the worker wedged when the in-flight job outlives HY3D_JOB_MAX_S or the loop
+    thread is gone: fails every outstanding job with the reason (a client polling /status gets
+    a terminal answer at once), latches /queue healthy:false, and exits 3 unless told not to."""
+    global _STUCK
+    while not _WATCHDOG_STOP.wait(WATCHDOG_S):
+        now = time.monotonic()
+        _WATCHDOG_LAST[0] = now        # the tick /queue reports as watchdog_age_s
+        with _JOBS_LOCK:
+            if _STUCK is not None:
+                continue               # already declared (HY3D_STUCK_EXIT=0): latched, quiet
+            dead = _LOOP_THREAD is not None and not _LOOP_THREAD.is_alive()
+            over = [(uid, now - j["started_at"]) for uid, j in _JOBS.items()
+                    if j["status"] == "processing" and j.get("started_at") is not None
+                    and JOB_MAX_S and now - j["started_at"] > JOB_MAX_S]
+            if not dead and not over:
+                continue
+            if over:
+                uid, age = over[0]
+                reason = (f"job {uid} exceeded HY3D_JOB_MAX_S={JOB_MAX_S}s (running {age:.0f}s)"
+                          " - generation wedged, worker recycling")
+            else:
+                reason = "generation loop thread died - worker cannot generate, recycling"
+            _STUCK = {"reason": reason, "since": now}
+            for j in _JOBS.values():
+                if j["status"] in ("processing", "queued"):
+                    j.update(status="error", error=reason)
+        logger.critical("WATCHDOG: %s%s", reason,
+                        f" -> exit 3 in {STUCK_EXIT_GRACE_S}s" if STUCK_EXIT
+                        else " (HY3D_STUCK_EXIT=0: staying up unhealthy)")
+        if STUCK_EXIT:
+            # hold the honest state for the grace window (health 503, /status 'error', /send
+            # 503), then take the process down - start.sh sees the exit and drops the container
+            time.sleep(STUCK_EXIT_GRACE_S)
+            logger.critical("WATCHDOG: exiting 3 (HY3D_STUCK_EXIT_GRACE_S=%d elapsed)", STUCK_EXIT_GRACE_S)
+            logging.shutdown()
+            os._exit(3)
+
+
+def start_watchdog():
+    global _WATCHDOG_THREAD
+    _WATCHDOG_STOP.clear()
+    _WATCHDOG_LAST[0] = time.monotonic()   # counts as a tick: no false 'stalled' before the first one
+    t = threading.Thread(target=_watchdog, name="hy3d-watchdog", daemon=True)
+    t.start()
+    _WATCHDOG_THREAD = t
+    return t
+
+
+def start_generation_loop():
+    global _LOOP_THREAD
+    t = threading.Thread(target=_generation_loop, name="hy3d-generate", daemon=True)
+    t.start()
+    _LOOP_THREAD = t
+    start_watchdog()
+    return t
 
 
