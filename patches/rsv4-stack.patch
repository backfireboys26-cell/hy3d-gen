+# --- LOCAL PATCH (2026-08-25): honest async failure reporting ---
+# /send ran worker.generate in a raw thread with NO exception capture, and /status inferred
+# state solely from "does the output .glb exist yet?". A worker crash (e.g. the FlashVDM
+# IndexError on empty occupancy) therefore left /status returning 'processing' FOREVER, so the
+# only downstream failure detector was generate3d.py's per-candidate wall-clock timeout - a
+# crashed seed silently burned the full --timeout-s (420s). Record terminal error state here so
+# /status can return {status:error} the instant the worker thread dies; generate3d.poll() already
+# handles status=='error' and fails the seed in seconds. Success is still detected by the file,
+# so the happy path is unchanged.
+JOB_ERRORS = {}                    # uid(str) -> {"status":"error", "error": "<Type: msg>"}
+JOB_ERRORS_LOCK = threading.Lock()
+
+
+def _run_generate(uid, params):
+    try:
+        worker.generate(uid, params)
+    except Exception as e:
+        logger.error("generate worker crashed for uid %s:\n%s", uid, traceback.format_exc())
+        with JOB_ERRORS_LOCK:
+            JOB_ERRORS[str(uid)] = {"status": "error", "error": f"{type(e).__name__}: {e}"}
+
+
 @app.post("/send")
