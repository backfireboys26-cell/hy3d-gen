+    kind = SERVED[name]["kind"]
+    if kind not in want_kinds:
+        what = {"single": "a single-image shape model", "mv": "a multiview shape model",
+                "nvs": "a view-synthesis model"}[kind]
+        return None, f"model: {name} is {what} - use {other}"
+    return name, None
