+def validate_imagine_params(params):
+    """(clean, None) or (None, "field: why") for POST /imagine."""
+    if not isinstance(params, dict):
+        return None, "body: a JSON object is required"
+    clean = {k: v for k, v in params.items() if v is not None}
+    if "image" not in clean:
+        return None, "image: required (base64-encoded PNG/JPEG - the front view to imagine the others from)"
+    if not (isinstance(clean["image"], str) and clean["image"].strip()):
+        return None, "image: must be a non-empty base64 string"
+    if "steps" not in clean and "num_inference_steps" in clean:
+        clean["steps"] = clean["num_inference_steps"]
+    for k, v in _IMAGINE_DEFAULTS.items():
+        clean.setdefault(k, v)
+    why = _check_ranges(clean, _IMAGINE_INT, _IMAGINE_FLOAT)
+    if why is not None:
+        return None, why
+    if clean["size"] % 8:
+        return None, f"size: must be a multiple of 8 (got {clean['size']})"
+    views = clean.get("views", list(IMAGINE_VIEWS))
+    if not isinstance(views, list) or not views:
+        return None, f"views: must be a non-empty list drawn from {list(IMAGINE_VIEWS)}"
+    seen = []
+    for v in views:
