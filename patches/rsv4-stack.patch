+async def send(request: Request):
+    global _JOB_SEQ
+    try:
+        params = await request.json()
+    except Exception:
+        return JSONResponse({"error": "body: invalid JSON", "field": "body"}, status_code=400)
+    clean, why = validate_params(params)
+    if why is not None:
+        return JSONResponse({"error": why, "field": why.split(":", 1)[0]}, status_code=400)
+    uid = str(uuid.uuid4())
+    with _JOBS_LOCK:
+        in_flight, queued = _backlog_locked()
+        if in_flight + queued >= 1 + QUEUE_MAX:
+            retry_after = max(5, (in_flight + queued) * JOB_ETA_S)
+            logger.warning("Worker send: busy (in_flight=%d queued=%d max=%d) -> 429",
+                           in_flight, queued, QUEUE_MAX)
+            return JSONResponse(
+                {"status": "busy", "error": f"busy: 1 generation in flight and {queued} queued "
+                                            f"(queue_max {QUEUE_MAX}); retry after {retry_after}s",
+                 "in_flight": in_flight, "queued": queued, "queue_max": QUEUE_MAX,
+                 "retry_after_s": retry_after},
+                status_code=429, headers={"Retry-After": str(retry_after)})
+        _JOB_SEQ += 1
+        _JOBS[uid] = {"status": "queued", "seq": _JOB_SEQ, "error": None}
+        _prune_locked()
+        position = queued + 1
+    _QUEUE.put((uid, clean))
+    logger.info("Worker send: uid %s queued (position %d, in_flight %d)", uid, position, in_flight)
+    return JSONResponse({"uid": uid, "status": "queued", "position": position}, status_code=200)
 
 
