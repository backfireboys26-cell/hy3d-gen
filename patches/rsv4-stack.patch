+    rename there is no file at the final path, after it there is the whole file. Verifier P2
+    (round 2): a big export takes seconds, and /status latched the truncated bytes as
+    'completed' with a matching sha - a truncated mesh looked like success to the client."""
+    final = result_path(uid, type)
+    partial = final + '.partial'
+    try:
+        mesh.export(partial, file_type=type)
+        os.replace(partial, final)
+    finally:
+        if os.path.exists(partial):
+            os.remove(partial)
+    return final
+
