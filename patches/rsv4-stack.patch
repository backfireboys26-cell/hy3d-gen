+# --- LOCAL PATCH (2026-08-25 + 2026-09-02): honest async state, bounded single-flight queue,
+# parameter validation, honest 404 ---
+# /send used to start a raw thread per request with NO exception capture and NO limit: two
+# clients double-loaded the card (each generation holds its own activations; two at once on a
+# 24 GB card OOM or thrash), and /status inferred state solely from "does the .glb exist yet?"
+# - a crashed worker OR an unknown uid (a worker replaced by the load balancer, a typo) read
+# 'processing' forever, so the only downstream failure detector was generate3d.py's per-seed
+# wall-clock timeout (a replaced worker burned the client's full budget).
+# Now:
+#   * ONE generation thread consumes a FIFO; at most 1 generation in flight and at most
+#     HY3D_QUEUE_MAX (default 4 = the endpoint's REQUEST_COUNT scaling target) queued; beyond
+#     that /send answers 429 + Retry-After + a JSON body, instantly, so the caller can back off
+#     or fan out to another worker instead of piling onto this one.
+#   * /send validates the numeric fields BEFORE accepting the job: octree_resolution 64..512,
+#     num_inference_steps 1..100, guidance_scale 0..30, seed an integer torch can seed with;
+#     anything else is a 400 naming the field. Unknown fields are ignored (never fatal).
+#   * /status knows every uid it has accepted: 'queued' (with position), 'processing', 'error'
+#     (with the exception), 'completed' (file present, as before). An unknown uid is a 404
+#     {"status": "not_found"} - never a guess. generate3d.poll() already stops on 'error' and
+#     on a non-200, so both terminal cases fail a seed in seconds, not minutes.
+QUEUE_MAX = max(0, int(os.environ.get("HY3D_QUEUE_MAX", "4")))
+# seconds per outstanding job used for Retry-After (a 4090 does 30 steps at octree 384 in ~10 s;
+# Pascal takes ~180 s - tune per host, it is only advice to the client)
+JOB_ETA_S = max(1, int(os.environ.get("HY3D_JOB_ETA_S", "30")))
+_JOBS_KEEP = 512                       # terminal records kept for /status before pruning
+_UID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
+
+_JOBS = {}                             # uid -> {"status", "seq", "error"}
+_JOBS_LOCK = threading.Lock()
+_JOB_SEQ = 0
+_QUEUE = queue.Queue()                 # (uid, params) FIFO for the single generation thread
+
+_INT_RANGES = {
+    "octree_resolution": (64, 512),
+    "num_inference_steps": (1, 100),
+    # torch.Generator.manual_seed accepts [-2**63, 2**64-1]
+    "seed": (-(1 << 63), (1 << 64) - 1),
+}
+_FLOAT_RANGES = {"guidance_scale": (0.0, 30.0)}
+
+
+def _as_int(v):
+    if isinstance(v, bool):
+        return None
+    if isinstance(v, int):
+        return v
+    if isinstance(v, float) and math.isfinite(v) and v.is_integer():
+        return int(v)
+    if isinstance(v, str) and re.fullmatch(r"\s*[+-]?\d+\s*", v):
+        return int(v)
+    return None
+
+
+def _as_float(v):
+    if isinstance(v, bool):
+        return None
+    if isinstance(v, (int, float)):
+        return float(v) if math.isfinite(v) else None
+    if isinstance(v, str):
+        try:
+            f = float(v)
+        except ValueError:
+            return None
+        return f if math.isfinite(f) else None
+    return None
+
+
+def validate_params(params):
+    """(clean_params, None) or (None, "field: why"). Null-valued keys count as absent."""
+    if not isinstance(params, dict):
+        return None, "body: a JSON object is required"
+    clean = {k: v for k, v in params.items() if v is not None}
+    if "image" not in clean and "mesh" not in clean:
+        return None, "image: required (base64-encoded PNG/JPEG)"
+    if "image" in clean and not (isinstance(clean["image"], str) and clean["image"].strip()):
+        return None, "image: must be a non-empty base64 string"
+    for key, (lo, hi) in _INT_RANGES.items():
+        if key in clean:
+            v = _as_int(clean[key])
+            if v is None:
+                return None, f"{key}: must be an integer"
+            if not lo <= v <= hi:
+                return None, f"{key}: must be within [{lo}, {hi}] (got {v})"
+            clean[key] = v
+    for key, (lo, hi) in _FLOAT_RANGES.items():
+        if key in clean:
+            v = _as_float(clean[key])
+            if v is None:
+                return None, f"{key}: must be a number"
+            if not lo <= v <= hi:
+                return None, f"{key}: must be within [{lo}, {hi}] (got {v})"
+            clean[key] = v
+    if "mc_algo" in clean and clean["mc_algo"] not in ("mc", "dmc"):
+        return None, "mc_algo: must be 'mc' or 'dmc'"
+    if "type" in clean and clean["type"] != "glb":
+        return None, "type: only 'glb' is served by /status"
+    return clean, None
+
+
+def _backlog_locked():
+    """(in_flight, queued); caller holds _JOBS_LOCK."""
+    in_flight = sum(1 for j in _JOBS.values() if j["status"] == "processing")
+    queued = sum(1 for j in _JOBS.values() if j["status"] == "queued")
+    return in_flight, queued
+
+
+def _prune_locked():
+    terminal = sorted((j["seq"], uid) for uid, j in _JOBS.items()
+                      if j["status"] in ("completed", "error"))
+    for _, uid in terminal[:max(0, len(terminal) - _JOBS_KEEP)]:
+        _JOBS.pop(uid, None)
+
+
+def _generation_loop():
+    """The ONLY place worker.generate runs: one job at a time, FIFO, state recorded honestly."""
+    while True:
+        uid, params = _QUEUE.get()
+        try:
+            with _JOBS_LOCK:
+                job = _JOBS.get(uid)
+                if job is None:
+                    continue
+                job["status"] = "processing"
+            try:
+                worker.generate(uid, params)
+                with _JOBS_LOCK:
+                    _JOBS[uid]["status"] = "completed"
+            except Exception as e:
+                logger.error("generate worker crashed for uid %s:\n%s", uid, traceback.format_exc())
+                with _JOBS_LOCK:
+                    _JOBS[uid].update(status="error", error=f"{type(e).__name__}: {e}")
+        finally:
+            _QUEUE.task_done()
+
+
+def start_generation_loop():
+    t = threading.Thread(target=_generation_loop, name="hy3d-generate", daemon=True)
+    t.start()
+    return t
 
 
