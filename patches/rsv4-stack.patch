+def publish_bytes(data, uid, type):
+    """The same atomic publish for a result that is already bytes (an /imagine view set as JSON)."""
+    final = result_path(uid, type)
+    partial = final + '.partial'
+    try:
+        with open(partial, 'wb') as f:
+            f.write(data)
+        os.replace(partial, final)
+    finally:
+        if os.path.exists(partial):
+            os.remove(partial)
+    return final
