+def _check_ranges(clean, int_ranges, float_ranges):
+    for key, (lo, hi) in int_ranges.items():
+        if key in clean:
+            v = _as_int(clean[key])
+            if v is None:
+                return f"{key}: must be an integer"
+            if not lo <= v <= hi:
+                return f"{key}: must be within [{lo}, {hi}] (got {v})"
+            clean[key] = v
+    for key, (lo, hi) in float_ranges.items():
+        if key in clean:
+            v = _as_float(clean[key])
+            if v is None:
+                return f"{key}: must be a number"
+            if not lo <= v <= hi:
+                return f"{key}: must be within [{lo}, {hi}] (got {v})"
+            clean[key] = v
+    if "background_removed" in clean and not isinstance(clean["background_removed"], bool):
+        return "background_removed: must be true or false"
+    return None
